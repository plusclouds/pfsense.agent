[Unit]
Description=PlusClouds Ubuntu VM Agent
Documentation=https://github.com/plusclouds/vm.agent
After=network-online.target systemd-resolved.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root

ExecStartPre=/bin/chmod 0750 /var/log/plusclouds

ExecStart=/usr/local/bin/plusclouds-agent

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=plusclouds-agent

# Load optional environment overrides (agent UUID, API key, log path, etc.)
EnvironmentFile=-/etc/plusclouds/environment

# Security
#
# NOTE: every ReadWritePaths= entry below must already exist on disk before
# this unit is (re)started. systemd sets up the mount namespace — including
# the ReadWritePaths= bind mounts — before running ExecStartPre, so an
# ExecStartPre=mkdir here cannot create a missing entry: the namespace setup
# itself fails first with "226/NAMESPACE". The installer (scripts/install.sh,
# `make install`, the .deb postinst) is responsible for creating these paths.
NoNewPrivileges=yes
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/plusclouds /etc/plusclouds /media/plusclouds-config
StateDirectory=plusclouds
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
