#!/bin/sh
#
# PROVIDE: plusclouds_agent
# REQUIRE: NETWORKING SERVERS
# KEYWORD: shutdown
#
# Add the following to /etc/rc.conf.local (NOT /etc/rc.conf — pfSense
# regenerates /etc/rc.conf from config.xml on every config write, which
# would silently drop a manually-added enable flag there) to enable this
# service:
#
# plusclouds_agent_enable="YES"
#
# IMPORTANT: the enable flag above only affects `service plusclouds-agent
# {start,stop,status}` — it does NOT make this start automatically at
# boot. pfSense replaces the entire boot sequence with its own
# /etc/pfSense-rc, which only calls a hardcoded handful of specific
# scripts by name and never does a generic scan of /usr/local/etc/rc.d/
# (unlike stock FreeBSD's rcorder/local_startup mechanism). To actually
# start this at boot, register it via pfSense's built-in
# system/afterbootupshellcmd config.xml field instead — see install.sh /
# scripts/pfsense-install.sh, which do this automatically.

. /etc/rc.subr

name="plusclouds_agent"
rcvar="${name}_enable"
desc="PlusClouds pfSense agent"

load_rc_config "${name}"

: ${plusclouds_agent_enable:="NO"}
: ${plusclouds_agent_daemon_log:="/var/log/plusclouds/plusclouds-agent.daemon.log"}

pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -o ${plusclouds_agent_daemon_log} -t plusclouds-agent /usr/local/bin/plusclouds-agent"

# daemon(8)'s -p writes the PID of the actual agent process (its child),
# not of daemon(8) itself — but rc.subr's status/stop checks default to
# verifying the pidfile's PID belongs to a process named after $command
# ("daemon"). Without this, status/stop never find the running agent (it's
# named "plusclouds-agent", not "daemon") and report "not running" even
# while it's alive and working.
procname="/usr/local/bin/plusclouds-agent"

start_precmd="${name}_prestart"

# There's no config file — the agent reads its identity and runtime config
# from the config-drive ISO (pc-meta-data.json) attached to this VM. If
# there's no config-drive attached (e.g. local testing), an optional
# /etc/plusclouds/environment file (KEY=VALUE lines, same format Linux's
# systemd EnvironmentFile= expects) can set PLUSCLOUDS_AGENT_* overrides —
# sourced and exported here so daemon(8)'s child process inherits them.
plusclouds_agent_prestart()
{
	mkdir -p /var/log/plusclouds
	if [ -f /etc/plusclouds/environment ]; then
		set -a
		. /etc/plusclouds/environment
		set +a
	fi
}

run_rc_command "$1"
